{
  "framework": "vite",
  "installCommand": "cd web && bun install",
  "buildCommand": "cd web && bun run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    {
      "source": "/prod-api/:path*",
      "destination": "https://maas.gravitex.ai/prod-api/:path*"
    },
    {
      "source": "/((?!gw/|prod-api/).*)",
      "destination": "/index.html"
    }
  ]
}
