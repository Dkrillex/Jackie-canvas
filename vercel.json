{
  "framework": "vite",
  "installCommand": "cd web && bun install",
  "buildCommand": "cd web && bun run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    {
      "source": "/gw/:path*",
      "destination": "https://api.gravitex.ai/:path*"
    },
    {
      "source": "/((?!gw/).*)",
      "destination": "/index.html"
    }
  ]
}
