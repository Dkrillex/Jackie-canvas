# Jackie Canvas 充值服务配置。复制成 .env 后填写。
# 没配支付宝或 MySQL 时服务照常启动，只有 /api/pay/* 和 /api/wallet/* 回 503。

# ---------- 服务 ----------
# HOST=0.0.0.0
# PORT=8787
# 允许跨域的前端来源，逗号分隔。本地开发走 Vite 代理时用不到；
# 前端和本服务不同域名部署时必须填上前端域名，不要在生产留 *
# CORS_ORIGIN=https://你的前端域名

# ---------- 支付宝（电脑网站支付）----------
# 两个密钥极容易搞混：
#   ALIPAY_PRIVATE_KEY  你的「应用私钥」，用来给请求签名
#   ALIPAY_PUBLIC_KEY   「支付宝公钥」（开放平台上它给你的那串），用来验它发来的通知
# 配反了的表现是：下单成功、收银台正常，但用户付完款订单永远停在未付 —— 通知验签过不了。
# 两者都只填 PEM 的 base64 正文，不要带 -----BEGIN----- / -----END----- 那两行。
# PKCS#1 和 PKCS#8 都能识别，不用管当年导出时选的是「JAVA 适用」还是「非 JAVA 适用」。
# ALIPAY_APP_ID=2021xxxxxxxxxxxx
# ALIPAY_PRIVATE_KEY=MIIEvQIBADANBgkq...
# ALIPAY_PUBLIC_KEY=MIIBIjANBgkqhkiG...
#
# 网关。沙箱调试用 https://openapi-sandbox.dl.alipaydev.com/gateway.do
# ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
#
# 异步通知地址，必须公网可达并指向本服务的 /api/pay/notify。
# 本地开发用内网穿透（ngrok/frp）把它暴露出去。留空不影响到账 —— 前端轮询和后台对账
# 会兜住，只是慢一点。
# ALIPAY_NOTIFY_URL=https://你的域名/api/pay/notify
#
# 付完之后浏览器跳回来的页面。它只说明「用户回来了」，不是付款成功的凭据。
# ALIPAY_RETURN_URL=https://你的前端域名/wallet

# 充值档位。不填用内置的两档（50/200 元）。在线单笔最多 200 元，更高档会被丢掉。
# 价目表只认服务端这一份，前端传过来的只有档位 id，永远不收金额。
# RECHARGE_PACKAGES=[{"id":"starter","amount":"50.00","credits":"7.00","bonus":"0.00","subject":"Jackie Canvas 积分充值 50 元"}]

# ---------- 订单与钱包库（MySQL）----------
# 表会在首次连接时自动建：recharge_orders / user_wallets / wallet_ledger
# MYSQL_HOST=rm-xxxx.mysql.rds.aliyuncs.com
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=
# MYSQL_CONNECTION_LIMIT=10

# ---------- 兜底对账 ----------
# 每隔多少秒把待付单拿去问一次支付宝。设成 0 或负数就关掉。
# RECONCILE_INTERVAL_SEC=60
# RECONCILE_WINDOW_MIN=1440

# ---------- 用户身份 ----------
# 本服务不自建账号，把前端带来的 MaaS JWT 拿去问 MaaS「你是谁」。
# AUTH_API_BASE=https://maas.gravitex.ai/prod-api
# AUTH_CLIENT_ID=e5cd7e4891bf95d1d19206ce24a7b32e
# 与前端 web/src/constant/auth.ts 里的 AUTH_RSA_PRIVATE_KEY 保持一致，
# 用来解密 MaaS 加密返回的响应体；不填用内置的那把。
# AUTH_RSA_PRIVATE_KEY=
# token → userId 的缓存秒数。前端轮询订单是 2 秒一次，调太小会把 MaaS 打出限流。
# AUTH_CACHE_SEC=60
